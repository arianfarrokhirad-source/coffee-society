# =====================================================================
# JARVIS environment variables — PLACEHOLDERS ONLY. Never commit real
# values. Copy to apps/command-center/.env.local for local development
# and set the same variables in Vercel for deployment.
# =====================================================================

# ---- Supabase ----
# PUBLIC (safe in the browser): project URL and anon key. The anon key
# only works through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: bypasses RLS. Never expose to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers (SERVER-ONLY) ----
# Either or both. With neither configured, JARVIS chat still handles the
# deterministic command set; free-form reasoning is disabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Model routing (SERVER-ONLY, required for model-backed routes) ----
# No model names are hard-coded anywhere; set current model IDs here.
# executive/extraction run on OpenAI, document/review on Anthropic by
# default (cross-provider fallback applies automatically).
JARVIS_MODEL_EXECUTIVE=
JARVIS_MODEL_DOCUMENT=
JARVIS_MODEL_EXTRACTION=
JARVIS_MODEL_REVIEW=

# ---- Application (SERVER-ONLY unless noted) ----
# Public base URL of the deployment (used in docs/links; safe to expose).
JARVIS_APP_URL=
# Min 16 chars. Bearer token for POST /api/cron/daily-brief.
JARVIS_CRON_SECRET=
# Reserved for future at-rest encryption of integration credentials.
# Not consumed in Phase 1; generate 32+ random bytes when you set it.
JARVIS_ENCRYPTION_KEY=
