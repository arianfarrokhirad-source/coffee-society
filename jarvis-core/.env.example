# =====================================================================
# JARVIS environment variables — PLACEHOLDERS ONLY. Never commit real
# values. Copy to apps/command-center/.env.local for local development
# and set the same variables in Vercel for deployment.
# =====================================================================

# ---- Supabase ----
# PUBLIC (safe in the browser): project URL and anon key. The anon key
# only works through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: bypasses RLS. Never expose to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers (SERVER-ONLY) ----
# Either or both. With neither configured, JARVIS chat still handles the
# deterministic command set; free-form reasoning is disabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Model routing (SERVER-ONLY, required for model-backed routes) ----
# No model names are hard-coded anywhere; set current model IDs here.
# executive/extraction run on OpenAI, document/review on Anthropic by
# default (cross-provider fallback applies automatically).
JARVIS_MODEL_EXECUTIVE=
JARVIS_MODEL_DOCUMENT=
JARVIS_MODEL_EXTRACTION=
JARVIS_MODEL_REVIEW=

# --- Gemini (added with the provider-agnostic router) ------------------
# Server-side only. Never NEXT_PUBLIC_, never committed.
GEMINI_API_KEY=

# Per-provider model overrides. JARVIS_MODEL_<PROVIDER> is that provider's
# default for any route; JARVIS_MODEL_<PROVIDER>_<ROUTE> overrides one
# route. A provider with no model configured is skipped by the router
# rather than handed another vendor's model name.
JARVIS_MODEL_GEMINI=
# JARVIS_MODEL_GEMINI_EXTRACTION=
# JARVIS_MODEL_ANTHROPIC=
# JARVIS_MODEL_OPENAI=

# --- Embeddings --------------------------------------------------------
# Per-provider embedding model. A provider with no model here is skipped,
# and Anthropic is never a candidate because it ships no embedding
# endpoint. With none set, the app runs without a semantic index rather
# than failing at query time.
#
# WARNING: changing a model here invalidates every vector already stored
# with the old one. Vectors are only comparable within a single
# (provider, model) space; mixing them does not error, it just quietly
# returns the wrong neighbours. Re-index after any change.
JARVIS_EMBEDDING_GEMINI=
# JARVIS_EMBEDDING_OPENAI=
# Optional vector width for models that support truncation. Leave unset
# for the model's native width.
# JARVIS_EMBEDDING_DIMENSIONS=

# --- Knowledge layer ---------------------------------------------------
# Both stores are read from disk by the /knowledge page and degrade to an
# empty panel when absent — a missing code index never breaks a page.
#
# If set, these are AUTHORITATIVE: a configured path that does not exist
# reports "unavailable" rather than falling back to a discovered one. A
# mistyped path must not silently serve a different vault.
# Leave unset to auto-discover relative to the working directory.
JARVIS_VAULT_PATH=
# The Graphify index is derived data and is not committed. CI rebuilds it
# on every push; absence in a deployment is expected, not a fault.
JARVIS_GRAPH_INDEX=

# --- AI cost tracking --------------------------------------------------
# Versioned pricing table as inline JSON. Without it, cost is reported as
# unknown (never zero) and any configured hard cost budget DENIES every
# request — being unable to measure spend is not permission to spend.
# Shape: {"version":"...","currency":"USD","source":"...",
#         "models":{"gemini:gemini-2.5-flash":{"inputPerMillion":0,"outputPerMillion":0}}}
JARVIS_AI_PRICING=

# ---- Application (SERVER-ONLY unless noted) ----
# Public base URL of the deployment (used in docs/links; safe to expose).
JARVIS_APP_URL=
# Min 16 chars. Bearer token for POST /api/cron/daily-brief.
JARVIS_CRON_SECRET=
# One-time PRIME bootstrap secret. Min 32 chars; generate real entropy:
#   openssl rand -base64 32
# Do NOT hand-write a 32-character phrase. Without this set, claiming
# PRIME is disabled entirely (fail closed). Remove or rotate it once the
# founder account has claimed PRIME. See docs/setup/supabase.md.
JARVIS_PRIME_SETUP_TOKEN=
# Reserved for future at-rest encryption of integration credentials.
# Not consumed in Phase 1; generate 32+ random bytes when you set it.
JARVIS_ENCRYPTION_KEY=
